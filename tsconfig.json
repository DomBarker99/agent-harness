{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  // src/practice holds intentionally-erroring teaching exercises with their own
  // tsconfigs (npm run ts-practice). Excluded here so this project's check stays green.
  "exclude": ["src/practice"]
}
