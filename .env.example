# Required. Choose a text model with tool-calling support that your account can access.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional. Leave blank to use the public OpenRouter API.
# For a development proxy, include its complete API path, for example http://localhost:8080/api/v1.
OPENROUTER_BASE_URL=

# Optional. Enables the web_search tool. Without it, the tool reports that it is not configured.
BRAVE_SEARCH_API_KEY=
