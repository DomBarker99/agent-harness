# Point the harness at any OpenAI-compatible endpoint.
# These are the defaults baked into the code, so the app runs with NO .env at all.
# Copy this file to .env only when you want to change them.

MODEL_BASE_URL=http://gemma.lan/v1
MODEL_ID=gemma-4-12b

# Heavier multi-tool chains? Switch to qwen3 on vLLM.
# Note: hitting llm.lan triggers a GPU swap via the arbiter (it preempts gemma).
# MODEL_BASE_URL=http://llm.lan/v1
# MODEL_ID=<the id from: curl http://llm.lan/v1/models>

# Optional. Most local servers ignore it; any non-empty string works.
# MODEL_API_KEY=local
